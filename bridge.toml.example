# libID OAuth Bridge configuration.
#
# Point the bridge at a copy of this file:
#
#     LIBID_CONFIG=/etc/libid/bridge.toml libid-bridge-rs
#     libid-bridge-rs --config ./bridge.toml
#
# This file is the deployment. Nothing here has a flag or a variable of its
# own: the enabled platforms can be written nowhere else, and a bridge with no
# platform could serve no ceremony, so there is one place to look and nothing
# to disagree with it. An unknown key is refused at startup. The bind address
# and port are set with HOST and PORT, or --host and --port, because where the
# process listens is not ceremony configuration.

# The application allowlist: what may read the public ceremony configuration.
# A member is one of three kinds.
#
# An exact origin admits itself, in canonical form -- no trailing slash,
# lowercase host, no default port:
#
#     allowed_app_origins = ["https://app.example"]
#
# An origin pattern is *. and then the host suffix whose subdomains it admits,
# with no scheme prefix:
#
#     allowed_app_origins = ["*.handles.link"]
#
# It admits every HTTPS origin whose host ends in that suffix at a label
# boundary, at any depth, and not the suffix itself. The suffix is DNS labels:
# lowercase alphanumeric, hyphens only inside a label, and the last label
# begins with a letter. So no scheme, no port, no path, no uppercase, no
# underscore, no trailing dot, no empty label and no second *. A member
# carrying a * that is not a well-formed pattern is refused at startup rather
# than read as an exact origin.
#
# A bare * admits every origin:
#
#     allowed_app_origins = ["*"]
#
# A pattern places the whole subdomain namespace of its suffix, at every
# depth, inside the trust boundary. No public suffix list is consulted. What
# an allowlist admits is the responsibility of whoever writes it.
#
# A member that is not an exact origin needs a Callback that understands one.
# A Callback published before origin-pattern support reads the list by the
# exact-origin rule, raising invalidCallbackInputs and rendering its failure
# text for every ceremony the deployment serves. Publish the CCDP Distribution
# named below with pattern support first, then configure the member.
allowed_app_origins = ["https://app.example", "https://wallet.example"]

# The CCDP Distribution: the origin serving the Callback artifact, the list of
# the platform ceremony versions it bundles, and everything the browser runs
# after the callback. Omit for the canonical libID Distribution.
ccdp_origin = "https://lib.id"


# The enabled platforms: one table per platform, naming the OAuth client its
# ceremony versions run. Which versions are advertised is not written here:
# the Distribution publishes the versions it bundles, and the bridge
# advertises exactly those, each with the client below. A platform the
# Distribution lists no version for is not advertised.
#
# The github table also carries the OAuth App's client secret, which the
# bridge publishes as clientCredential: public application configuration the
# browser's token request sends as client_secret. No other platform's
# ceremony sends one, and a credential on another table is refused.
[[platforms]]
id = "github"
default_client_id = "Iv1.0123456789abcdef"
default_client_credential = "0123456789abcdef0123456789abcdef01234567"

# A version may run a client of its own: a version_override table keyed by
# the version, bare or quoted, carrying a whole client -- client_id, and
# client_credential exactly where the platform's ceremony sends one. The
# defaults above stay required. An override for a version the Distribution
# does not list is ignored, and logged when the configuration is composed.
#
#     [platforms.version_override.2]
#     client_id = "Iv1.fedcba9876543210"
#     client_credential = "76543210fedcba9876543210fedcba9876543210"

# [[platforms]]
# id = "google"
# default_client_id = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# [[platforms]]
# id = "x"
# default_client_id = "XXXXXXXXXXXXXXXXXXXXXXXXXX"

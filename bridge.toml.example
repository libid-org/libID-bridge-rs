# libID OAuth Bridge configuration.
#
# Point the bridge at a copy of this file:
#
#     LIBID_CONFIG=/etc/libid/bridge.toml libid-server-rs
#     libid-server-rs --config ./bridge.toml
#
# This file is the deployment. Nothing here has a flag or a variable of its
# own: the enabled platforms can be written nowhere else, and a bridge with no
# platform could serve no ceremony, so there is one place to look and nothing
# to disagree with it. An unknown key is refused at startup. The bind address
# and port are set with HOST and PORT, or --host and --port, because where the
# process listens is not ceremony configuration.

# The application allowlist: what may read the public ceremony configuration.
# A member is an exact origin in canonical form -- no trailing slash, lowercase
# host, no default port -- or an origin pattern, *. and then the host suffix
# whose subdomains it admits, with no scheme prefix:
#
#     allowed_app_origins = ["https://app.example", "*.handles.link"]
#
# *.handles.link admits every HTTPS origin whose host ends in .handles.link, at
# any depth: https://app.handles.link and https://a.b.handles.link, and not
# https://handles.link itself. The suffix is DNS labels: lowercase
# alphanumeric, hyphens only inside a label, and the last label begins with a
# letter, so no scheme, no port, no path, no uppercase, no underscore, no
# trailing dot, no empty label and no second *. A member carrying a * that is
# not a well-formed pattern is refused at startup rather than read as an exact
# origin.
#
# Two members the browser accepts are refused here, by name and by index: a
# bare *, because an allowlist this bridge publishes names what it serves, and
# a suffix of one label such as *.com, because a whole top-level domain is not
# an allowlist.
#
# No public suffix list is consulted, so *.vercel.app is accepted: a pattern
# places the whole subdomain namespace of its suffix, at every depth, inside
# the trust boundary, and the operator writing one asserts control of that
# namespace.
#
# A Callback published before origin-pattern support refuses a member that is
# not a URL, raising invalidCallbackInputs and rendering its failure text for
# every ceremony the deployment serves. Publish the CCDP Distribution named
# below with pattern support first, then configure the pattern.
#
# A suffix of one label is refused, so *.localhost is not a local shortcut.
# Name each loopback origin: http://localhost and http://127.0.0.1 are exact
# members at any port.
allowed_app_origins = ["https://app.example", "https://wallet.example"]

# The CCDP Distribution: the origin serving the Callback artifact and
# everything the browser runs after it. Omit for the canonical libID
# Distribution.
ccdp_origin = "https://lib.id"


# The enabled platforms: one table per platform, with its public client id and
# the ceremony versions it advertises. The github table also carries the OAuth
# App's client secret, which the bridge publishes as clientCredential:
# public application configuration the browser's token request sends as
# client_secret.
[[platforms]]
id = "github"
client_id = "Iv1.0123456789abcdef"
versions = [1]
client_credential = "0123456789abcdef0123456789abcdef01234567"

# [[platforms]]
# id = "google"
# client_id = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
# versions = [1]

# [[platforms]]
# id = "x"
# client_id = "XXXXXXXXXXXXXXXXXXXXXXXXXX"
# versions = [1]
